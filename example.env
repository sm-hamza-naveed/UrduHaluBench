# UrduHaluBench - API keys
# 1. Copy this file and name the copy  .env  (in the repository root)
# 2. Paste your real keys after the = sign (no quotes, no spaces)
# 3. Never share or upload .env - it is listed in .gitignore

# Claude (Anthropic) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ChatGPT (OpenAI) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Hugging Face (only needed for Llama on your own PC; Colab asks separately)
HF_TOKEN=hf_your-token-here
